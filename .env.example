# Öffentliche Basis-URL der Website (für Canonicals, Sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:5550

# Lead-Speicher.
#   file = JSON-Datei unter ./data/leads.json  (NUR lokale Entwicklung / Einzelserver)
#   none = keine Speicherung; das Formular meldet offen, dass keine Anfragen
#          entgegengenommen werden können (Standard in Produktion, solange keine
#          Datenbank angebunden ist).
LEAD_STORE=file

# Optional: abweichender Speicherort der Lead-Datei (Standard: <Projekt>/data/leads.json).
# LEAD_STORE_PATH=

# Geheimer Schlüssel, mit dem ausgehende Partner-Webhooks signiert werden (HMAC-SHA256).
# Nur nötig, sobald ein Partner mit integration.art = "webhook" aktiv ist.
PARTNER_WEBHOOK_SECRET=

# Webhook-Ziel je Partner: PARTNER_WEBHOOK_URL_<PARTNER_ID in Großbuchstaben, - wird zu _>
# Beispiel für die Partner-ID "partner-01":
# PARTNER_WEBHOOK_URL_PARTNER_01=
